APP_NAME="Get It Done"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_DATABASE=backend_test
DB_USERNAME=get_it_done_user
DB_PASSWORD=password

# Host-run tests against docker-compose MySQL published port
DB_HOST=127.0.0.1
DB_PORT=3307

# If tests run inside the backend container, use:
# DB_HOST=db
# DB_PORT=3306

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

